{
  "expo": {
    "name": "Dear Days",
    "slug": "dear-days",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.seunome.deardays"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FAF7F2",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.seunome.deardays"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro",
      "name": "Dear Days",
      "shortName": "Dear Days",
      "description": "Seu planner gentil: um dia de cada vez.",
      "themeColor": "#FAF7F2",
      "backgroundColor": "#FAF7F2",
      "lang": "pt-BR"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#8A6579"
        }
      ],
      "expo-sharing"
    ],
    "scheme": "deardays",
    "experiments": {
      "typedRoutes": false
    }
  }
}
